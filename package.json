{
  "name": "logofat",
  "version": "0.1.0",
  "description": "Logofăt: a Pi extension that adds /route <prompt> to route a prompt to the best installed coding harness.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "logofat"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "test:smoke": "bash test/smoke-pi.sh"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24"
  }
}
